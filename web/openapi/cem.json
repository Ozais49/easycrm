  "components": {
    "schemas": {
      "AuditAction": {
        "enum": [
          "created",
          "updated",
          "deleted"
        ]
      },
      "AuditEntryDto": {
        "required": [
          "id",
          "occurredAt",
          "userId",
          "action",
          "entityType",
          "entityId",
          "changes"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "userId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "action": {
            "$ref": "#/components/schemas/AuditAction"
          },
          "entityType": {
            "type": "string"
          },
          "entityId": {
            "type": "string",
            "format": "uuid"
          },
          "changes": {
            "$ref": "#/components/schemas/JsonElement"
          }
        }
      },
      "DateDisplay": {
        "enum": [
          "ad",
          "bs",
          "both"
        ]
